# Effort watchdog conf (harness v2.9). Sourced by harness/watchdog-template.sh. The effort's watchdog.sh is:
#   #!/usr/bin/env bash
#   exec bash "$(dirname "$(readlink -f "$0")")/generic-harness/watchdog-template.sh" "$(dirname "$(readlink -f "$0")")/watchdog.conf"
STATUS_DIR=/abs/path/to/effort/status            # where rooms write NN-STATE*.md files
ORCH_DIR=/abs/path/to/effort/orch                # expectations.tsv, ESCALATIONS.md, digest.md, .checks/, metrics/ live here
# EXP=$ORCH_DIR/expectations.tsv                 # default
# MET=$ORCH_DIR/metrics/fleet-ctx.csv            # default
REVIEW_CMD="bash $ORCH_DIR/eval.sh"              # produces the daily scorecard; "true" if the effort has none yet
SOFT_CTX=700000; HARD_CTX=850000                 # rotation lines (tokens)
ROTATION_DOC="ROTATION.md"; REPLACE_DOC="room-procedures §2"   # names quoted in ROTATE escalations
# ACT_RE / TRIAGE_RE may be overridden when the effort's status vocabulary differs from the seeding one.
# (v2.9, G10 rule 8) Decision-packet SLA: rows "#decision=<id>\t<posted_epoch>\t<note>" in expectations.tsv;
# escalates once per id past DECISION_SLA_HOURS unless $DECISIONS_DIR/<id>.answered exists.
DECISIONS_DIR=$ORCH_DIR/decisions                # touch $DECISIONS_DIR/<id>.answered when a packet is answered
DECISION_SLA_HOURS=24
# (v2.9, G4 inbox-touch check) path to the correction-event inbox this instance appends to; the daily REVIEW
# escalates once if the inbox's mtime has not advanced since the previous REVIEW cycle.
DEVIATIONS_INBOX=/abs/path/to/DEVIATIONS-inbox.md
# (v2.9, G10 rule 7) Takeover-exam regeneration and EXAM_SOURCES/EXAM_MIN_* keys are REMOVED: the self-graded
# exam never caught a divergence and is cut from this template. If an instance still has EXAM_SOURCES set from
# a pre-v2.9 conf, it is now inert; delete the key on next derivation.
