{
  "name": "claude-channel-mux",
  "version": "0.3.2",
  "description": "Multi-channel, multi-agent room multiplexer for Claude Code and Codex over Slack/Telegram via Agent SPI.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "daemon": "bun install --no-summary && bun daemon.ts",
    "start": "bun install --no-summary && bun server.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "check:diff": "git diff --check",
    "validate": "bun run test && bun run typecheck && bun run check:diff",
    "e2e:preflight": "scripts/e2e-preflight.sh",
    "build:wasm": "cd zellij-plugin && cargo build --release --target wasm32-wasip1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@slack/socket-mode": "^2.0.0",
    "@slack/web-api": "^7.8.0",
    "slackify-markdown": "^5.0.0",
    "telegramify-markdown": "^1.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "slack",
    "telegram",
    "multiplexer",
    "channel"
  ]
}
