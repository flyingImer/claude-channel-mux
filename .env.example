# Slack (both required for Slack support)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Telegram (required for Telegram support)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# At least one platform must be configured.

# Default agent for plain messages in new rooms: claude or codex. Override per room with `ccm default claude|codex`.
CHANNEL_DAEMON_DEFAULT_AGENT=claude
# Backcompat aliases also accepted: CHANNEL_DAEMON_AGENT or CCM_AGENT

# Optional room/session defaults
# CHANNEL_DAEMON_CWD=/path/to/default/repo
# CHANNEL_DAEMON_SPAWN_MODE=same-dir

# Optional binary/model/plugin overrides
CLAUDE_BIN=claude
CODEX_BIN=codex
# Forward selected env vars into Claude zellij tabs when the zellij server has stale env.
# CHANNEL_DAEMON_FORWARD_ENV=ANTHROPIC_API_KEY,OPENAI_API_KEY
# Optional dev plugin dir and marketplace override for Claude plugin channel tag.
# CLAUDE_CHANNEL_MUX_PLUGIN_DIR=/path/to/claude-channel-mux
# CLAUDE_CHANNEL_MUX_MARKETPLACE=claude-channel-mux
# Codex app-server slots create a sibling git worktree by default when possible.
# Set to off/false/0 to run Codex directly in the room cwd.
# CCM_CODEX_WORKTREE=off
# CHANNEL_DAEMON_CODEX_WORKTREE=off
# Codex app-server inherits daemon env. Set this if Codex is not already logged in via its own config.
# OPENAI_API_KEY=sk-...
# Optional: override Codex app-server model if your config default is not desired
# CCM_CODEX_MODEL=gpt-5.4
# CODEX_MODEL=gpt-5.4
# Optional: production-only Codex YOLO style. Defaults stay safer (`on-request`, workspace-write).
# CCM_CODEX_APPROVAL_POLICY=never
# CCM_CODEX_SANDBOX=danger-full-access
# Back-compat shortcut recognized by CCM production service:
# CODEX_YOLO=1

# Optional: isolated E2E/cutover safety settings. Use these together when
# testing with production Slack/Telegram tokens to avoid touching production state.
# CHANNEL_DAEMON_STATE_DIR=/tmp/ccm-e2e-state
# CHANNEL_DAEMON_ZELLIJ_SESSION=ccmux-test
# CHANNEL_DAEMON_ALLOWED_CHANNELS=slack:C123TEST,telegram:-100123TEST

# Optional: test-only prefix that lets bot-authored messages drive inbound E2E tests
# CHANNEL_DAEMON_SELF_TEST_PREFIX=[ccm-test]

# Optional: ask_peer deterministic product gates (not a security boundary without isolation)
# CCM_ASK_PEER_RATE_LIMIT=12
# CHANNEL_DAEMON_ASK_PEER_RATE_LIMIT=12
# CCM_ASK_PEER_RATE_WINDOW_MS=60000
# CHANNEL_DAEMON_ASK_PEER_RATE_WINDOW_MS=60000
# CCM_ASK_PEER_MAX_INFLIGHT_PER_ROOM=4
# CHANNEL_DAEMON_ASK_PEER_MAX_INFLIGHT_PER_ROOM=4
# CCM_ASK_PEER_INFLIGHT_TTL_MS=600000
# CHANNEL_DAEMON_ASK_PEER_INFLIGHT_TTL_MS=600000
# CCM_COLLAB_MAX_HANDOFFS=4
# CHANNEL_DAEMON_COLLAB_MAX_HANDOFFS=4
# CCM_COLLAB_STALE_TTL_MS=7200000
# CHANNEL_DAEMON_COLLAB_STALE_TTL_MS=7200000
# CCM_PEER_REPLY_INJECTION_MAX_CHARS=2000
# CHANNEL_DAEMON_PEER_REPLY_INJECTION_MAX_CHARS=2000
# CCM_AGENT_CONTEXT_TURN_MAX_CHARS=8000
# CHANNEL_DAEMON_AGENT_CONTEXT_TURN_MAX_CHARS=8000
